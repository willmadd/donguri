generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id            String             @id @db.Uuid
  email         String
  fullName      String?            @map("full_name")
  role          String             @default("user")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  xp            Float              @default(0)
  donguriConfig Json?              @map("donguri_config")
  enrollments   CourseEnrollment[]
  addedByOthers Friendship[]       @relation("FriendshipsAsFriend")
  friendsAdded  Friendship[]       @relation("FriendshipsAsUser")
  wordProgress  UserWordProgress[]

  @@map("profiles")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Friendship {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  friendId  String   @map("friend_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  friend    Profile  @relation("FriendshipsAsFriend", fields: [friendId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      Profile  @relation("FriendshipsAsUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, friendId])
  @@map("friendships")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Course {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String             @unique
  title          String
  targetLanguage String             @map("target_language")
  sourceLanguage String             @map("source_language")
  description    String?
  position       Int
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  active         Boolean            @default(true)
  enrollments    CourseEnrollment[]
  lessons        Lesson[]

  @@map("courses")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model CourseEnrollment {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  courseId            String    @map("course_id") @db.Uuid
  enrolledAt          DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  currentStreak       Int       @default(0) @map("current_streak")
  longestStreak       Int       @default(0) @map("longest_streak")
  lastActivityDate    DateTime? @map("last_activity_date") @db.Date
  lastStreakBonusDate DateTime? @map("last_streak_bonus_date") @db.Date
  course              Course    @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile             Profile   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, courseId])
  @@map("course_enrollments")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Lesson {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  path      String
  title     String
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  courseId  String   @map("course_id") @db.Uuid
  active    Boolean  @default(true)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  words     Word[]

  @@unique([courseId, path, position])
  @@map("lessons")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Word {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId        String             @map("lesson_id") @db.Uuid
  term            String
  translation     String
  exampleSentence String?            @map("example_sentence")
  position        Int
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  romanization    String?
  active          Boolean            @default(true)
  imageKey        String?            @map("image_key")
  explanation     String?
  explanationJa   String?            @map("explanation_ja")
  categoryId      String?            @map("category_id") @db.Uuid
  wordType        String?            @map("word_type")
  progress        UserWordProgress[]
  examples        WordExample[]
  forms           WordForm[]
  quizQuestions   WordQuizQuestion[]
  category        WordCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  lesson          Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([lessonId, position])
  @@map("words")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model WordQuizQuestion {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wordId       String   @map("word_id") @db.Uuid
  prompt       String
  promptJa     String?  @map("prompt_ja")
  options      String[]
  correctIndex Int      @map("correct_index")
  position     Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  word         Word     @relation(fields: [wordId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([wordId, position])
  @@map("word_quiz_questions")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model WordForm {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wordId    String        @map("word_id") @db.Uuid
  labelEn   String        @map("label_en")
  labelJa   String        @map("label_ja")
  value     String
  position  Int
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  examples  WordExample[]
  word      Word          @relation(fields: [wordId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([wordId, position])
  @@map("word_forms")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model WordExample {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wordId    String    @map("word_id") @db.Uuid
  formId    String?   @map("form_id") @db.Uuid
  en        String
  ja        String
  position  Int
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  form      WordForm? @relation(fields: [formId], references: [id], onUpdate: NoAction)
  word      Word      @relation(fields: [wordId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([wordId, position])
  @@map("word_examples")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model UserWordProgress {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  wordId         String    @map("word_id") @db.Uuid
  status         String    @default("learning")
  box            Int       @default(1)
  correctCount   Int       @default(0) @map("correct_count")
  incorrectCount Int       @default(0) @map("incorrect_count")
  skipped        Boolean   @default(false)
  introducedAt   DateTime  @default(now()) @map("introduced_at") @db.Timestamptz(6)
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  profile        Profile   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  word           Word      @relation(fields: [wordId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, wordId])
  @@map("user_word_progress")
}

// A cross-deck topical tag with its own admin-managed color — distinct from
// a "category" elsewhere in this app, which is the admin UI's name for a
// `Lesson` (deck). E.g. the "Colours" word-category can appear on words
// inside a "TOEIC Basic" deck.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model WordCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  color     String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  words     Word[]

  @@map("word_categories")
}
