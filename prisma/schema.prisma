generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                     String                  @id @db.Uuid
  email                  String
  fullName               String?                 @map("full_name")
  firstName              String?                 @map("first_name")
  lastName               String?                 @map("last_name")
  role                   String                  @default("user")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  // Total experience points — incremented only by the vocab quiz actions in
  // lib/actions/vocab.ts (+1 per correct answer, +5 bonus for a perfect
  // quiz, plus a half-point-per-day streak bonus), never set directly from
  // a user-editable form field. A float (not Int) because the streak bonus
  // is awarded in 0.5 increments.
  xp                     Float                   @default(0)
  // Free-form settings blob the user can view/edit as raw JSON from their
  // profile page — no fixed shape yet, deliberately generic.
  donguriConfig          Json?                   @map("donguri_config")
  enrollments            CourseEnrollment[]
  addedByOthers          Friendship[]            @relation("FriendshipsAsFriend")
  friendsAdded           Friendship[]            @relation("FriendshipsAsUser")
  deckActivations        UserDeckActivation[]
  wordProgress           UserWordProgress[]
  dailyChallengeAttempts DailyChallengeAttempt[]

  @@map("profiles")
}

// One-directional: `userId` added `friendId` to their own friends list, no
// acceptance step needed — just enough for a personal "friends leaderboard"
// alongside the global top-10.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Friendship {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  friendId  String   @map("friend_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  friend    Profile  @relation("FriendshipsAsFriend", fields: [friendId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      Profile  @relation("FriendshipsAsUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, friendId])
  @@map("friendships")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Course {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                   String                  @unique
  title                  String
  targetLanguage         String                  @map("target_language")
  sourceLanguage         String                  @map("source_language")
  description            String?
  position               Int
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  active                 Boolean                 @default(true)
  enrollments            CourseEnrollment[]
  languageDecks          LanguageDeck[]
  dailyChallengeAttempts DailyChallengeAttempt[]

  @@map("courses")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model CourseEnrollment {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  courseId            String    @map("course_id") @db.Uuid
  enrolledAt          DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  currentStreak       Int       @default(0) @map("current_streak")
  longestStreak       Int       @default(0) @map("longest_streak")
  lastActivityDate    DateTime? @map("last_activity_date") @db.Date
  // The last UTC date this course's streak XP bonus was awarded — so
  // completing a second quiz on the same day doesn't award it again.
  lastStreakBonusDate DateTime? @map("last_streak_bonus_date") @db.Date
  course              Course    @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile             Profile   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, courseId])
  @@map("course_enrollments")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model LanguageDeck {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  path          String
  title         String
  subheading    String?
  description   String?
  coverImageKey String?              @map("cover_image_key")
  bgColor       String?              @map("bg_color")
  primaryColor  String?              @map("primary_color")
  position      Int
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  courseId      String               @map("course_id") @db.Uuid
  active        Boolean              @default(true)
  // Short, free-text labels shown as badges on deck cards — a per-deck
  // list, not a shared/reusable taxonomy (see WordCategory for that shape).
  tags          String[]             @default([])
  course        Course               @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  activations   UserDeckActivation[]
  words         Word[]

  @@unique([courseId, path, position])
  @@map("language_decks")
}

// A user's personal "active decks" list within a course — which decks
// currently feed the Learn/Test pool (see getActiveDeckIds/
// getLearnQueueForCourse in lib/dal.ts). Only ever keyed by a `path: 'vocab'`
// LanguageDeck (a "deck"); its grammar sibling, if any, activates implicitly
// along with it. `active` is a real column (not row presence/absence) so
// "explicitly deactivated" stays distinguishable from "never touched" even
// after every deck is turned off — getActiveDeckIds needs that distinction
// to only lazily auto-activate the first deck once, on a brand-new
// enrollment, never re-activating something the user deliberately turned off.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model UserDeckActivation {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  languageDeckId String       @map("language_deck_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  active         Boolean      @default(true)
  languageDeck   LanguageDeck @relation(fields: [languageDeckId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile        Profile      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, languageDeckId])
  @@map("user_deck_activations")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Word {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  languageDeckId  String             @map("language_deck_id") @db.Uuid
  term            String
  translation     String
  exampleSentence String?            @map("example_sentence")
  position        Int
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  romanization    String?
  active          Boolean            @default(true)
  imageKey        String?            @map("image_key")
  explanation     String?
  explanationJa   String?            @map("explanation_ja")
  categoryId      String?            @map("category_id") @db.Uuid
  wordType        String?            @map("word_type")
  progress        UserWordProgress[]
  examples        WordExample[]
  forms           WordForm[]
  quizQuestions   WordQuizQuestion[]
  category        WordCategory?      @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  languageDeck    LanguageDeck       @relation(fields: [languageDeckId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([languageDeckId, position])
  @@map("words")
}

// Hand-authored multiple-choice questions an admin adds for a specific word.
// Editable from the admin quiz-questions page, but not currently mixed into
// the auto-generated quiz/review question builders in lib/dal.ts.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model WordQuizQuestion {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wordId       String   @map("word_id") @db.Uuid
  prompt       String
  promptJa     String?  @map("prompt_ja")
  options      String[]
  correctIndex Int      @map("correct_index")
  position     Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  word         Word     @relation(fields: [wordId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([wordId, position])
  @@map("word_quiz_questions")
}

// A word's inflected/conjugated forms (e.g. go/goes/went/gone/going). Generic
// on purpose — labels are free text set by the admin — so it also covers
// non-verb inflections (noun plurals, adjective comparatives) without a
// schema change.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model WordForm {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wordId    String        @map("word_id") @db.Uuid
  labelEn   String        @map("label_en")
  labelJa   String        @map("label_ja")
  value     String
  position  Int
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  examples  WordExample[]
  word      Word          @relation(fields: [wordId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([wordId, position])
  @@map("word_forms")
}

// Example sentence pairs for a word. `formId` optionally ties an example to
// the specific form it demonstrates (used to build "type the form" quiz
// questions from the Japanese side); null means a general example not tied
// to one form.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model WordExample {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wordId    String    @map("word_id") @db.Uuid
  formId    String?   @map("form_id") @db.Uuid
  en        String
  ja        String
  position  Int
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  form      WordForm? @relation(fields: [formId], references: [id], onUpdate: NoAction)
  word      Word      @relation(fields: [wordId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([wordId, position])
  @@map("word_examples")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model UserWordProgress {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  wordId         String    @map("word_id") @db.Uuid
  status         String    @default("learning")
  // 1-7, see the STAGES table in lib/srs.ts — replaces the old 1-5 "box".
  // Stage 7 is "Mastered" (status flips to 'known', nextReviewAt cleared).
  stage          Int       @default(1)
  correctCount   Int       @default(0) @map("correct_count")
  incorrectCount Int       @default(0) @map("incorrect_count")
  skipped        Boolean   @default(false)
  introducedAt   DateTime  @default(now()) @map("introduced_at") @db.Timestamptz(6)
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  // When this word is next due in the review queue — null until the word's
  // very first quiz question is answered (see `lastSeenAt`), and null again
  // once it reaches stage 7 (mastered, no more reviews).
  nextReviewAt   DateTime? @map("next_review_at") @db.Timestamptz(6)
  profile        Profile   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  word           Word      @relation(fields: [wordId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, wordId])
  @@map("user_word_progress")
}

// A cross-deck topical tag with its own admin-managed color — distinct from
// a "category" elsewhere in this app, which is the admin UI's name for a
// `LanguageDeck` (deck). E.g. the "Colours" word-category can appear on words
// inside a "TOEIC Basic" deck.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model WordCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  color     String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  words     Word[]

  @@map("word_categories")
}

// One row per attempt of the (currently stub) daily challenge — capped at 3
// per user per course per UTC day, enforced in the app layer (see
// completeDailyChallenge in lib/actions/daily-challenge.ts) rather than a DB
// constraint, since the cap is a product rule that may change.
// `challengeDate` is stored explicitly (rather than derived from
// `createdAt`) so "how many today" is a plain equality filter regardless of
// query-time timezone, matching `lastActivityDate` on `CourseEnrollment`.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model DailyChallengeAttempt {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  courseId      String   @map("course_id") @db.Uuid
  challengeDate DateTime @map("challenge_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, courseId, challengeDate], map: "daily_challenge_attempts_user_course_date_idx")
  @@map("daily_challenge_attempts")
}
