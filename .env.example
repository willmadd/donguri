# Supabase — find these in Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Postgres — find these in Project Settings → Database → Connection string.
# DATABASE_URL: use the "Transaction" pooler (port 6543, add ?pgbouncer=true)
#   for app queries — this is what Prisma Client uses at runtime.
# DIRECT_URL: use the direct connection (port 5432) — Prisma CLI commands
#   (migrate, db pull) need an unpooled connection.
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
